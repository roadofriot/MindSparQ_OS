# Copy to .env or pass via Gradle properties (-PMINDSPARQ_SUPABASE_URL=... -PMINDSPARQ_SUPABASE_ANON_KEY=...)
# Safe for public client apps ONLY when Row-Level Security (RLS) is enabled on all tables.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in client apps.
MINDSPARQ_SUPABASE_URL=https://your-project-ref.supabase.co
MINDSPARQ_SUPABASE_ANON_KEY=your-public-anon-key
